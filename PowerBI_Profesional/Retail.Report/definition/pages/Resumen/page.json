{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "Resumen",
  "displayName": "01 · Resumen ejecutivo",
  "displayOption": "FitToPage",
  "height": 900,
  "width": 1600,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#EFEFEF'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          },
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'Fondo_Resumen.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "Fondo_Resumen.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
