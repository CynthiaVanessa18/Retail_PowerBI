			isDefault
			relationship: da9f003d-17d2-4afb-985a-32705716bc2e
			defaultHierarchy: LocalDateTable_127391dd-be01-485e-a16f-35d58e96d046.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column Mes
		dataType: string
		lineageTag: 42b5adad-9c7a-4c38-8538-5f6d1b8943d0
