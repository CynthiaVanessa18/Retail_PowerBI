	column VentaValida
		dataType: boolean
		lineageTag: f48e6dda-800c-43a3-bc14-c782ffa6162a
		summarizeBy: none
		sourceColumn: VentaValida

	partition Ventas = m
		mode: import
		source =
				let
				    Fuente = Excel.Workbook(File.Contents(RutaExcel), null, true),
				    Hoja = Fuente{[Item="Online Retail", Kind="Sheet"]}[Data],
				    Encabezados = Table.PromoteHeaders(Hoja, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"InvoiceNo", type text}, {"StockCode", type text}, {"Description", type text}, {"Quantity", Int64.Type}, {"InvoiceDate", type datetime}, {"UnitPrice", type number}, {"CustomerID", type text}, {"Country", type text}}, "en-GB"),
				    Fecha = Table.AddColumn(Tipos, "Fecha", each Date.From([InvoiceDate]), type date),
				    Mes = Table.AddColumn(Fecha, "Mes", each Date.ToText([Fecha], "yyyy-MM"), type text),
				    Importe = Table.AddColumn(Mes, "Importe", each [Quantity] * [UnitPrice], type number),
				    Valida = Table.AddColumn(Importe, "VentaValida", each [Quantity] > 0 and [UnitPrice] > 0 and not Text.StartsWith(Text.Upper([InvoiceNo]), "C"), type logical)
				in
				    Valida

	annotation PBI_ResultType = Table
